{
  "name": "actors",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "import:human": "tsx tools/import-makehuman/src/import.ts",
    "dev": "npm run dev --workspace @actors/viewer",
    "build": "npm run build --workspace @actors/viewer",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:packages": "node scripts/release/build.mjs",
    "check:consumer": "node scripts/release/check-consumer.mjs"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4",
    "esbuild": "0.23.1"
  },
  "license": "MIT"
}
